<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{name}}</title>
  <link rel="stylesheet" href="/public/css/buy.css">
</head>
<body>
  <div class="product-container">
    <div class="product-image">
      <img src="{{image}}" alt="{{type}}">
    </div>

    <div class="product-details">
      <h2 class="product-name" data-type="{{type}}">{{name}}</h2>
      <p class="product-price">₹ {{price}}</p>
      <p class="product-description">{{description}}</p>

      <!-- ✅ Buy button -->
      <a href="/order/{{name}}" class="buy-button">Proceed to Buy</a>
    </div>
  </div>

  <h3 class="related-title">Related Products</h3>
  <div id="related-products" class="related-products"></div>

  <script src="/public/js/buy.js"></script>
</body>
</html>
